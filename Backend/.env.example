# Backend environment variables (names only; set real values in Dokploy).
APP_ENV=prod
APP_DEBUG=0
# Random secret, >= 32 chars.
APP_SECRET=
# Base URI used for URL generation (e.g. https://clicker-api.example).
DEFAULT_URI=
# IP/CIDR of the reverse proxy (Traefik) allowed to set X-Forwarded-*.
# Required for per-client rate limiting to see real client IPs.
TRUSTED_PROXIES=
# mysql://USER:PASSWORD@HOST:3306/DB?serverVersion=X.Y&charset=utf8mb4
DATABASE_URL=
# ONE exact origin allowed by CORS (no regex), e.g. https://portfolio.example
CORS_ALLOW_ORIGIN=
# Admin deletion token (X-Admin-Token header), >= 32 random chars; shorter
# values are refused (fail closed). Rotate by changing the variable.
ADMIN_TOKEN=
# Seconds to wait for the database at boot before failing (default 60).
DB_WAIT_TIMEOUT=60
# 1 = apply migrations at boot under a DB lock (default); 0 = separate step.
RUN_MIGRATIONS=1
